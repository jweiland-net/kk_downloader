      <trans-unit id="tx_kkdownloader.results_at_a_time">
        <source>Max amount of records to show on list view</source>
        <target state="translated">Listanézetben megjeleníthető rekordok maximális száma</target>
      </trans-unit>
      <trans-unit id="tx_kkdownloader.results_at_a_time.description">
        <source>If empty we will show value of TypoScript which is by default 25. If you want to show all records set this value high enough.</source>
        <target state="translated">Ha üres, akkor a TypoScript értékét jelenítjük meg, ami alapértelmezetten 25. Ha minden rekordot meg szeretne jeleníteni, állítsa elég magasra ezt az értéket.</target>
      </trans-unit>
      <trans-unit id="tx_kkdownloader.showPagebrowser">
