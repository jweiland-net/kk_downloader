<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader_conf</sheetTitle>
                <type>array</type>
                <el>
                    <what_to_display>
                        <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.what_to_display</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <label>LIST</label>
                                    <value>LIST</value>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <label>SINGLE</label>
                                    <value>SINGLE</value>
                                </numIndex>
                            </items>
                            <size>1</size>
                        </config>
                    </what_to_display>
                    <category>
                        <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.category</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.category.all</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <foreign_table>sys_category</foreign_table>
                            <foreign_table_where>AND ('###PAGE_TSCONFIG_IDLIST###' = '0' OR sys_category.pid IN (###PAGE_TSCONFIG_IDLIST###)) AND sys_category.sys_language_uid = 0 AND sys_category.l10n_parent = 0 ORDER BY sys_category.title</foreign_table_where>
                        </config>
                    </category>
                    <showCats>
                        <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.showCats</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </showCats>
                    <orderby>
                        <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.orderby</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="1" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.orderbyTitle</label>
                                    <value>name</value>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.orderbyFilename</label>
                                    <value>image</value>
