                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="1" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.showFileMDate.nodate</label>
                                    <value>0</value>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.showFileMDate.date</label>
                                    <value>1</value>
                                </numIndex>
                                <numIndex index="3" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.showFileMDate.datetime</label>
