                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="1" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.asc</label>
