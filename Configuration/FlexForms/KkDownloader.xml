                                <numIndex index="2" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.showCRDate.date</label>
                                    <value>1</value>
                                </numIndex>
                                <numIndex index="3" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.showCRDate.datetime</label>
                                    <value>2</value>
