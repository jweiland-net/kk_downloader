                                </numIndex>
                                <numIndex index="4" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.orderbyLastModified</label>
                                    <value>tstamp</value>
                                </numIndex>
                                <numIndex index="5" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.orderbyCategory</label>
                                    <value>cat</value>
                                </numIndex>
                                <numIndex index="6" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.orderbyDateLastDownloaded</label>
                                    <value>last_downloaded</value>
                                </numIndex>
                                <numIndex index="7" type="array">
                                    <label>LLL:EXT:kk_downloader/Resources/Private/Language/FlexForm.xlf:tx_kkdownloader.orderbySorting</label>
                                    <value>sorting</value>
                                </numIndex>
                            </items>
                            <maxitems>1</maxitems>
                            <size>1</size>
                        </config>
                    </orderby>
                    <ascdesc>
